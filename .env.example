# Telegram
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=

# PinMX (Growth tier required for API access)
# Get your token at https://www.pinmx.com/ → upgrade to Growth → API token in dashboard
PINMX_TOKEN=
PINMX_DOMAINS=pinmx.net,pingmx.com

# Supabase — bot runtime (used by the bot to read/write rows)
# Project URL  → Dashboard → Settings → API → Project URL
# Service key  → Dashboard → Settings → API → Project API keys → service_role (NOT anon)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...

# Supabase — MCP server (used by Claude Code to manage your project)
# PAT          → https://supabase.com/dashboard/account/tokens → "Generate new token"
# Project ref  → the subdomain part of SUPABASE_URL (xxxxxxxxxxxx without the .supabase.co)
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_PROJECT_REF=xxxxxxxxxxxx

# Browser backend: "kameleo" (anti-detect, requires local Kameleo CLI running)
# or "playwright" (plain Chromium, no anti-detect)
BROWSER_MODE=kameleo
KAMELEO_BASE_URL=http://localhost:5050
KAMELEO_DEVICE_TYPE=desktop
KAMELEO_BROWSER_PRODUCT=chrome
KAMELEO_OS_FAMILY=windows

# Runtime
HEADLESS=true
VERIFY_TIMEOUT_SECONDS=120
BULK_THROTTLE_SECONDS=45
BULK_MAX=20
LIST_PAGE_SIZE=10

LOG_LEVEL=INFO
